{
  "expo": {
    "name": "Geno",
    "slug": "serious-app",
    "owner": "skai-devs-team",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/geno/ios/AppIcon~ios-marketing.png",
    "scheme": "seriousapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skylimit.seriousapp"
    },
    "android": {
      "package": "com.skylimit.seriousapp",
      "adaptiveIcon": {
        "backgroundColor": "#E91E63",
        "foregroundImage": "./assets/images/geno/android/res/mipmap-xxxhdpi/geno_foreground.png",
        "backgroundImage": "./assets/images/geno/android/res/mipmap-xxxhdpi/geno_background.png",
        "monochromeImage": "./assets/images/geno/android/res/mipmap-xxxhdpi/geno_monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/geno/web/icon-192.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/geno/ios/AppIcon~ios-marketing.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E91E63",
          "dark": {
            "backgroundColor": "#E91E63"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/geno/ios/AppIcon~ios-marketing.png",
          "color": "#E91E63",
          "androidMode": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3702286b-abe2-4a52-97b8-639f8a6c1065"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3702286b-abe2-4a52-97b8-639f8a6c1065"
    }
  }
}
