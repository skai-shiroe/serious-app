# Variables d'environnement - EXEMPLE (versionne, sans secret)
#
# Utilisation :  cp .env.example .env   puis renseignez vos acces Supabase.
#
# Valeurs a recuperer dans : Supabase -> Project Settings -> API
#
# IMPORTANT : les variables EXPO_PUBLIC_* sont PUBLIQUES (elles sont embarquees
# en clair dans l'application). La securite des donnees repose donc entierement
# sur les policies RLS de Supabase, jamais sur le secret de cette cle.
# Ne JAMAIS mettre ici de cle service_role : cet exemple est versionne.

EXPO_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<CLE_ANON_PUBLIQUE>
